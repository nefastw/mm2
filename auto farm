-- CONEXÕES DA GUI
---------------------------------------------------------
speedBox:GetPropertyChangedSignal("Text"):Connect(function()
    local val = tonumber(speedBox.Text)
    if val and val > 0 then
        velocidade = val
    end
end)

toggleBtn.MouseButton1Click:Connect(function()
    estaRodando = not estaRodando

    if estaRodando then
        toggleBtn.Text = "PARAR"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(231, 76, 60)
        pauseBtn.Visible = true
        pauseBtn.Text = "PAUSAR"
        emPausa = false
        
        table.clear(coinsVisitadas)
        task.spawn(irParaProximaCoin)
    else
        toggleBtn.Text = "INICIAR"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
        pauseBtn.Visible = false
        emPausa = false
        
        if tweenAtual then
            tweenAtual:Cancel()
        end
    end
end)

pauseBtn.MouseButton1Click:Connect(function()
    if not estaRodando then return end

    emPausa = not emPausa

    if emPausa then
        pauseBtn.Text = "CONTINUAR"
        pauseBtn.BackgroundColor3 = Color3.fromRGB(52, 152, 219)
        if tweenAtual then
            tweenAtual:Pause()
        end
    else
        pauseBtn.Text = "PAUSAR"
        pauseBtn.BackgroundColor3 = Color3.fromRGB(241, 196, 15)
        if tweenAtual then
            tweenAtual:Resume()
        end
    end
end)
