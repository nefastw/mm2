---------------------------------------------------------
-- LÓGICA DE BUSCA PELA MOEDA MAIS PRÓXIMA
---------------------------------------------------------
local function obterCoinMaisProxima()
    local menorDistancia = math.huge
    local coinMaisProxima = nil

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "Coin_Server" and obj:IsA("BasePart") and not coinsVisitadas[obj] then
            local distancia = (humanoidRootPart.Position - obj.Position).Magnitude
            if distancia < menorDistancia then
                menorDistancia = distancia
                coinMaisProxima = obj
            end
        end
    end

    return coinMaisProxima, menorDistancia
end

local function irParaProximaCoin()
    if not estaRodando then return end

    -- Se estiver pausado, aguarda até despausar
    while emPausa and estaRodando do
        task.wait(0.2)
    end

    if not estaRodando then return end

    -- Busca especificamente a Coin_Server mais próxima da posição atual
    local proximaCoin, distancia = obterCoinMaisProxima()

    if proximaCoin then
        coinsVisitadas[proximaCoin] = true

        local tempoDeMovimento = distancia / velocidade

        local tweenInfo = TweenInfo.new(
            tempoDeMovimento,
            Enum.EasingStyle.Linear
        )

        local goal = { CFrame = proximaCoin.CFrame }
        tweenAtual = TweenService:Create(humanoidRootPart, tweenInfo, goal)
        tweenAtual:Play()

        -- Aguarda o tween terminar
        local state = tweenAtual.Completed:Wait()

        if state == Enum.PlaybackState.Cancelled then
            return
        end

        print("Chegou na Coin_Server mais próxima!")
        
        -- Chama novamente para recalcular qual é a mais próxima agora
        irParaProximaCoin()
    else
        print("Todas as Coin_Server foram coletadas!")
        estaRodando = false
        toggleBtn.Text = "INICIAR"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
        pauseBtn.Visible = false
    end
end

